generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  WAREHOUSE_KEEPER
  DRIVER
}

enum OrderStatus {
  PENDING
  SHIPPED
  DELIVERED
  CANCELED
}

enum CartonStatus {
  IN_STOCK
  SHIPPED
  RETURNED
  EXITED
}

enum CartonEntryType {
  NEW
  RETURNED
}

enum TransferStatus {
  PENDING
  DONE
  CANCELED
}

enum TransactionType {
  IN
  OUT
  RETURN
}

enum DeliveryStatus {
  IN_TRANSIT
  DELIVERED
}

enum ActivityLogType {
  order_created
  order_updated
  order_deleted
  order_completed
  return_received
  product_checkin
  order_shipped
  product_archived
  product_created
  product_restored
  product_updated
  model_archived
  model_restored
  user_created
  user_deleted
  user_role_changed
  user_warehouse_changed
  warehouse_archived
  warehouse_restored
  warehouse_created
  warehouse_updated
  warehouse_keeper_changed
  product_transfer
  product_exit
}

model User {
  id                   String         @id @default(uuid())
  name                 String
  phone                String         @unique
  password             String
  role                 Role           @default(WAREHOUSE_KEEPER)
  avatarUrl            String?
  notificationSettings Json?
  warehouseId          String?
  warehouse            Warehouse?     @relation(fields: [warehouseId], references: [id])
  transactions         Transaction[]
  orders               Order[]        @relation("CreatedBy")
  cartons              Carton[]       @relation("CartonCreatedBy")
  notifications        Notification[]
  deliveries           Delivery[]     @relation("DeliveredBy")
  activityLogs         ActivityLog[]
  transfers            Transfer[]     @relation("TransferCreatedBy")
  refreshTokens        RefreshToken[]
  failedLoginAttempts  Int            @default(0)
  lockUntil            DateTime?
  mustChangePassword   Boolean        @default(false)
  tokenVersion         Int            @default(0)
  version              Int            @default(0)
  isActive             Boolean        @default(true)
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Warehouse {
  id           String        @id @default(uuid())
  name         String
  address      String?
  users        User[]
  transactions Transaction[]
  orders       Order[]
  cartons      Carton[]
  transfersFrom Transfer[]   @relation("TransferFrom")
  transfersTo   Transfer[]   @relation("TransferTo")
  version      Int           @default(0)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // توجه: ایندکس‌های trgm (raw ops) در خروجی `prisma migrate diff` همیشه drop/recreate
  // نمایش داده می‌شوند — محدودیت شناخته‌شده Prisma با raw()؛ با مهاجرت واقعی هیچ تداخلی ندارند.
  // در migrate dev حاصل را نسازید؛ فقط migrate deploy کنید.
  @@index([name(ops: raw("extensions.gin_trgm_ops"))], type: Gin, map: "Warehouse_name_trgm_idx")
  @@index([name], where: raw("deletedAt IS NULL"), map: "Warehouse_name_active_key")
}

model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType
  productName String
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity    Int
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  createdAt   DateTime        @default(now())

  @@index([warehouseId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([productName(ops: raw("extensions.gin_trgm_ops"))], type: Gin)
  @@index([productId])
}

model Product {
  id         String         @id @default(uuid())
  name       String
  unit       String         @default("عدد")
  models     ProductModel[]
  orderItems OrderItem[]
  cartons    Carton[]
  transactions Transaction[]
  transfers  Transfer[]
  version    Int            @default(0)
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([name(ops: raw("extensions.gin_trgm_ops"))], type: Gin, where: raw("deletedAt IS NULL"), map: "Product_name_trgm_idx")
  @@index([name], where: raw("deletedAt IS NULL"), map: "Product_name_active_key")
}

model ProductModel {
  id          String       @id @default(uuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal?     @db.Decimal(18, 2)
  packageType String?
  unitsPerBox Int?
  cartons     Carton[]
  orderItems  OrderItem[]
  transfers   Transfer[]
  version     Int          @default(0)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())

  @@unique([productId, name])
}

model Carton {
  id           String          @id @default(uuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  modelId      String?
  model        ProductModel?   @relation(fields: [modelId], references: [id], onDelete: SetNull)
  warehouseId  String
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  orderId      String?
  order        Order?          @relation(fields: [orderId], references: [id])
  transferId   String?
  transfer     Transfer?       @relation(fields: [transferId], references: [id], onDelete: SetNull)
  qrPayload    String          @unique
  hmac         String
  qrUuid       String          @unique @default(uuid())
  isIndividual Boolean         @default(false)
  entryType    CartonEntryType @default(NEW)
  serialNumber String?         @unique
  status       CartonStatus    @default(IN_STOCK)
  scannedOutAt DateTime?
  // لحظهٔ چاپ لیبل QR از پنل دسکتاپ — کارتن‌های چاپ‌شده از تب محصولات
  // خارج و به تب «چاپ شده‌ها» منتقل می‌شوند (بدون تغییر موجودی فیزیکی)
  printedAt    DateTime?
  createdById  String
  createdBy    User            @relation("CartonCreatedBy", fields: [createdById], references: [id])
  version      Int             @default(0)
  createdAt    DateTime        @default(now())

  @@index([warehouseId, status])
  @@index([productId, modelId])
  @@index([entryType])
  @@index([scannedOutAt])
  @@index([printedAt])
  @@index([orderId])
  @@index([serialNumber])
  @@index([serialNumber(ops: raw("extensions.gin_trgm_ops"))], type: Gin, map: "Carton_serialNumber_trgm_idx")
}

/// باربری‌های تعریف‌شده — مدیریت کامل توسط انباردار، انتخاب هنگام ثبت سفارش توسط مدیر
/// (Order.carrier نام باربری را به‌صورت متن نگه می‌دارد تا تاریخچه پس از ویرایش/حذف بماند)
model Carrier {
  id        String   @id @default(uuid())
  name      String   @unique
  priority  Int      @default(0)
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// شمارنده ترتیبی سریال کارتن‌ها به تفکیک سال شمسی — افزایش اتمی داخل تراکنش ورود کالا
model SerialSequence {
  year    Int @id
  lastSeq Int
}

model Order {
  id             String      @id @default(uuid())
  /// شمارهٔ روزانهٔ سفارش — از اول هر روزِ شمسی (کلید روز در orderDay) از ۱ شماره می‌خورد
  orderNumber    Int
  /// کلید روزِ شمسیِ ساخت سفارش (yyyymmdd) — مبنای شمارشِ روزانهٔ orderNumber
  orderDay       Int?
  warehouseId    String
  warehouse      Warehouse   @relation(fields: [warehouseId], references: [id])
  status         OrderStatus @default(PENDING)
  createdById    String
  createdBy      User        @relation("CreatedBy", fields: [createdById], references: [id])
  items          OrderItem[]
  cartons        Carton[]
  shippingMethod   String      @default("باربری")
  carrier          String?
  city             String?
  postalCode       String?
  address          String?
  customerPhone    String
  senderName       String?
  senderNationalId String?
  senderPhone      String?
  receiverName     String?
  delivery         Delivery?
  badges         Badge[]
  version        Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([orderDay, orderNumber])
  @@index([status, createdAt(sort: Desc)])
  @@index([warehouseId, status])
  @@index([createdById])
  @@index([createdAt(sort: Desc)])
}

/// ثبت رویدادهای سفارش برای «فعالیت‌های اخیر» — حتی بعد از حذف سفارش باقی می‌ماند
model ActivityLog {
  id        String          @id @default(uuid())
  type      ActivityLogType
  label     String
  orderId   String?
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([createdAt(sort: Desc)])
  @@index([type])
}

/// برگهٔ بیجک سفارش — عکسِ لحظهٔ ثبت از اطلاعات ارسال (بی‌تأثیر از ویرایش بعدی سفارش)
/// محتوای هر ردیف به «نحوه ارسال» بستگی دارد: باربری / تیپاکس (شهری بیجک نمی‌گیرد)
model Badge {
  id                 String   @id @default(uuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  count              Int      @default(1)
  // عکسِ قلمِ اولِ سفارش: نام مدل + نحوهٔ بسته‌بندی و تعداد هر بسته (از پنل مدیریت) —
  // روی برگهٔ بیجک «تعداد {نوع بسته}» (مثلاً «تعداد کیسه») نمایش داده می‌شود
  modelName          String?
  packageType        String?
  unitsPerBox        Int?
  // لحظهٔ چاپ برگه از پنل دسکتاپ — بیجک‌های چاپ‌شده از منوی «بیجک» حذف و
  // در تب «چاپ شده‌ها» (فیلتر بیجک) نمایش داده می‌شوند
  printedAt          DateTime?
  senderName         String?
  senderPhone        String?
  senderNationalId   String?
  receiverName       String?
  receiverCity       String?
  receiverPostalCode String?
  receiverAddress    String?
  receiverPhone      String?
  createdAt          DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id           String        @id @default(uuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product       @relation(fields: [productId], references: [id])
  quantity     Int
  model        String?
  modelId      String?
  modelRef     ProductModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  price        Decimal?      @db.Decimal(18, 2)
  exchangeRate Decimal?      @db.Decimal(18, 6)

  @@index([orderId])
  @@index([productId])
  @@index([modelId])
}

/// ثبت جابه‌جایی/خروج محصول توسط مدیر — مسیر خروج کالا از انبار خارج از سفارش
model Transfer {
  id              String        @id @default(uuid())
  fromWarehouseId String
  fromWarehouse   Warehouse     @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse?    @relation("TransferTo", fields: [toWarehouseId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  modelId         String?
  model           ProductModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  quantity        Int
  description     String        @default("")
  status          TransferStatus @default(PENDING)
  completedAt     DateTime?
  createdById     String
  createdBy       User          @relation("TransferCreatedBy", fields: [createdById], references: [id])
  cartons         Carton[]
  createdAt       DateTime      @default(now())

  @@index([fromWarehouseId, createdAt(sort: Desc)])
  @@index([toWarehouseId, createdAt(sort: Desc)])
  @@index([productId, createdAt(sort: Desc)])
  @@index([status, fromWarehouseId])
}

model Delivery {
  id          String         @id @default(uuid())
  orderId     String         @unique
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId    String
  driver      User           @relation("DeliveredBy", fields: [driverId], references: [id])
  status      DeliveryStatus @default(IN_TRANSIT)
  deliveredAt DateTime?
  notes       String?
  /// عکس بیجکی که باربری هنگام تحویل بار به راننده داده — پیش‌شرط ثبت تحویل
  receiptUrl  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([driverId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  data      Json?
  dedupeKey String?  @unique
  createdAt DateTime @default(now())

  @@index([userId], where: raw("isRead = false"), map: "Notification_unread_idx")
  @@index([userId, isRead, createdAt(sort: Desc)])
}

/// کلید یکتای عدم تکرار عملیات (Idempotency) — ورود کالا و خروج کالا
model IdempotencyKey {
  id           String   @id @default(uuid())
  userId       String
  operation    String
  key          String
  responseJson Json
  createdAt    DateTime @default(now())

  @@unique([userId, operation, key])
  @@index([createdAt])
}

/// رویدادهای خروجی تراکنشی (Transactional Outbox) — تحویل مطمئن پیام‌ها به سوکت/نوتیفیکیشن
model OutboxEvent {
  id           String    @id @default(uuid())
  aggregate    String
  type         String
  payload      Json
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?
  claimedAt    DateTime?

  @@index([status, createdAt])
  // ایندکس جزئی پولر: فقط رکوردهای PENDING را اسکن می‌کند (با SQL خام در مهاجرت enterprise ساخته شده)
  @@index([createdAt], where: raw("status = 'PENDING'"), map: "OutboxEvent_pending_idx")
  @@index([claimedAt], where: raw("status = 'DISPATCHING'"), map: "OutboxEvent_dispatching_idx")
}

/// ممیزی تغییرات حساس — چه کسی، چه چیزی، قبل/بعد، از کدام IP
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/// توکن‌های رفرش چرخشی — فقط هش ذخیره می‌شود
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// پیکربندی مدل هوش مصنوعی دستیار مدیر — یک ردیف تکی (id='default')
/// که از منوی تنظیمات مدیریت قابل ویرایش است تا مدل بدون تغییر کد/env عوض شود.
/// وقتی ردیفی وجود ندارد، دستیار به مقادیر پیش‌فرض env (ZAI_*) برمی‌گردد.
model AssistantConfig {
  id        String   @id @default("default")
  /// نام دلخواه برای نمایش (مثلاً «GLM-4.7-Flash»)
  name      String?
  /// آدرس پایهٔ سازگار با OpenAI — مثل https://api.z.ai/api/paas/v4
  baseUrl   String
  /// کلید API — خالی یعنی استفاده از کلید env (ZAI_API_KEY) یا بدون کلید برای مدل‌های محلی
  apiKey    String?
  model     String
  maxTokens Int      @default(8000)
  /// حالت فکرکردن (thinking) — افزونهٔ مخصوص Z.AI؛ برای سرویس‌دهنده‌های دیگر خاموش شود
  thinking  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
