generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  WAREHOUSE_KEEPER
  DRIVER
}

enum OrderStatus {
  PENDING
  SHIPPED
  DELIVERED
  CANCELED
}

enum CartonStatus {
  IN_STOCK
  SHIPPED
  RETURNED
}

enum CartonEntryType {
  NEW
  RETURNED
}

enum TransactionType {
  IN
  OUT
  RETURN
}

enum DeliveryStatus {
  IN_TRANSIT
  DELIVERED
}

enum ActivityLogType {
  order_created
  order_updated
  order_deleted
  order_completed
  return_received
  product_checkin
  order_shipped
  product_archived
  product_created
  product_restored
  product_updated
  model_archived
  model_restored
  user_created
  user_deleted
  user_role_changed
  user_warehouse_changed
  warehouse_archived
  warehouse_restored
}

model User {
  id                   String         @id @default(uuid())
  name                 String
  phone                String         @unique
  password             String
  role                 Role           @default(WAREHOUSE_KEEPER)
  avatarUrl            String?
  notificationSettings Json?
  warehouseId          String?
  warehouse            Warehouse?     @relation(fields: [warehouseId], references: [id])
  transactions         Transaction[]
  orders               Order[]        @relation("CreatedBy")
  cartons              Carton[]       @relation("CartonCreatedBy")
  notifications        Notification[]
  deliveries           Delivery[]     @relation("DeliveredBy")
  activityLogs         ActivityLog[]
  refreshTokens        RefreshToken[]
  failedLoginAttempts  Int            @default(0)
  lockUntil            DateTime?
  mustChangePassword   Boolean        @default(false)
  tokenVersion         Int            @default(0)
  version              Int            @default(0)
  isActive             Boolean        @default(true)
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Warehouse {
  id           String        @id @default(uuid())
  name         String
  address      String?
  users        User[]
  transactions Transaction[]
  orders       Order[]
  cartons      Carton[]
  version      Int           @default(0)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // توجه: ایندکس‌های trgm (raw ops) در خروجی `prisma migrate diff` همیشه drop/recreate
  // نمایش داده می‌شوند — محدودیت شناخته‌شده Prisma با raw()؛ با مهاجرت واقعی هیچ تداخلی ندارند.
  // در migrate dev حاصل را نسازید؛ فقط migrate deploy کنید.
  @@index([name(ops: raw("extensions.gin_trgm_ops"))], type: Gin, map: "Warehouse_name_trgm_idx")
}

model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType
  productName String
  quantity    Int
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  createdAt   DateTime        @default(now())

  @@index([warehouseId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([productName(ops: raw("extensions.gin_trgm_ops"))], type: Gin)
}

model Product {
  id         String         @id @default(uuid())
  name       String
  unit       String         @default("عدد")
  models     ProductModel[]
  orderItems OrderItem[]
  cartons    Carton[]
  version    Int            @default(0)
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([name(ops: raw("extensions.gin_trgm_ops"))], type: Gin, where: raw("deletedAt IS NULL"), map: "Product_name_trgm_idx")
}

model ProductModel {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal?  @db.Decimal(18, 2)
  packageType String?
  unitsPerBox Int?
  cartons     Carton[]
  version     Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([productId, name])
}

model Carton {
  id           String          @id @default(uuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  modelId      String?
  model        ProductModel?   @relation(fields: [modelId], references: [id], onDelete: SetNull)
  warehouseId  String
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  orderId      String?
  order        Order?          @relation(fields: [orderId], references: [id])
  qrPayload    String          @unique
  hmac         String
  qrUuid       String          @unique @default(uuid())
  isIndividual Boolean         @default(false)
  entryType    CartonEntryType @default(NEW)
  serialNumber String?         @unique
  status       CartonStatus    @default(IN_STOCK)
  scannedOutAt DateTime?
  createdById  String
  createdBy    User            @relation("CartonCreatedBy", fields: [createdById], references: [id])
  version      Int             @default(0)
  createdAt    DateTime        @default(now())

  @@index([warehouseId, status])
  @@index([productId, modelId])
  @@index([entryType])
  @@index([scannedOutAt])
  @@index([orderId])
  @@index([serialNumber])
  @@index([serialNumber(ops: raw("extensions.gin_trgm_ops"))], type: Gin, map: "Carton_serialNumber_trgm_idx")
}

/// شمارنده ترتیبی سریال کارتن‌ها به تفکیک سال شمسی — افزایش اتمی داخل تراکنش ورود کالا
model SerialSequence {
  year    Int @id
  lastSeq Int
}

model Order {
  id             String      @id @default(uuid())
  warehouseId    String
  warehouse      Warehouse   @relation(fields: [warehouseId], references: [id])
  status         OrderStatus @default(PENDING)
  createdById    String
  createdBy      User        @relation("CreatedBy", fields: [createdById], references: [id])
  items          OrderItem[]
  cartons        Carton[]
  shippingMethod String      @default("باربری")
  carrier        String?
  city           String?
  postalCode     String?
  address        String?
  customerPhone  String?
  senderName     String?
  receiverName   String?
  delivery       Delivery?
  badges         Badge[]
  version        Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([warehouseId, status])
  @@index([createdById])
  @@index([createdAt(sort: Desc)])
}

/// ثبت رویدادهای سفارش برای «فعالیت‌های اخیر» — حتی بعد از حذف سفارش باقی می‌ماند
model ActivityLog {
  id        String          @id @default(uuid())
  type      ActivityLogType
  label     String
  orderId   String?
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([createdAt(sort: Desc)])
  @@index([type])
}

model Badge {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sequence     Int      @default(1)
  senderName   String?
  receiverName String?
  createdAt    DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Int
  model        String?
  price        Decimal? @db.Decimal(18, 2)
  exchangeRate Decimal? @db.Decimal(18, 6)

  @@index([orderId])
  @@index([productId])
}

model Delivery {
  id          String         @id @default(uuid())
  orderId     String         @unique
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId    String
  driver      User           @relation("DeliveredBy", fields: [driverId], references: [id])
  status      DeliveryStatus @default(IN_TRANSIT)
  deliveredAt DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([driverId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId], where: raw("isRead = false"), map: "Notification_unread_idx")
  @@index([userId, isRead, createdAt(sort: Desc)])
}

/// کلید یکتای عدم تکرار عملیات (Idempotency) — ورود کالا و خروج کالا
model IdempotencyKey {
  id           String   @id @default(uuid())
  userId       String
  operation    String
  key          String
  responseJson Json
  createdAt    DateTime @default(now())

  @@unique([userId, operation, key])
  @@index([createdAt])
}

/// رویدادهای خروجی تراکنشی (Transactional Outbox) — تحویل مطمئن پیام‌ها به سوکت/نوتیفیکیشن
model OutboxEvent {
  id           String    @id @default(uuid())
  aggregate    String
  type         String
  payload      Json
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?

  @@index([status, createdAt])
  // ایندکس جزئی پولر: فقط رکوردهای PENDING را اسکن می‌کند (با SQL خام در مهاجرت enterprise ساخته شده)
  @@index([createdAt], where: raw("status = 'PENDING'"), map: "OutboxEvent_pending_idx")
}

/// ممیزی تغییرات حساس — چه کسی، چه چیزی، قبل/بعد، از کدام IP
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/// توکن‌های رفرش چرخشی — فقط هش ذخیره می‌شود
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
