# ─── نمونهٔ nginx برای تولید (TLS خاتمه می‌یابد، اپ فقط HTTP داخلی) ───
# مسیر: /etc/nginx/sites-available/ma-warehouse  →  symlink به sites-enabled
# گواهی: certbot --nginx -d api.your-domain.ir

# سقف کلی rate برای همهٔ کلاینت‌ها (جدید محدودتر در اپ خودش هست)
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=20r/s;

server {
    listen 80;
    server_name api.your-domain.ir;
    # فقط برای ACME challenge؛ بقیه به HTTPS ریدایرکت می‌شود
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.your-domain.ir;

    # ─── گواهی TLS (Let's Encrypt) ───
    ssl_certificate     /etc/letsencrypt/live/api.your-domain.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.your-domain.ir/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    # هدرهای امنیتی (helmet روی اپ هست؛ این‌ها لایهٔ لبه هستند)
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    # فایل‌های آپلود تا 3MB (اپ خودش 2MB سقف دارد)
    client_max_body_size 3m;

    # timeout ها برای WebSocket (socket.io)
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # HTTP/1.1 برای آپگرید WebSocket
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # هدرهای پروکسی — TRUST_PROXY=true در .env اپ باید ست شود
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # rate limit لبه‌ای
    limit_req zone=api_limit burst=40 nodelay;

    location / {
        proxy_pass http://127.0.0.1:3000;
    }
}
