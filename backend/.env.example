# ── اتصال دیتابیس ──
# نام دیتابیس (پیش‌فرض ma_warehouse — اسکریپت‌های backup/restore/verify همین را می‌خوانند)
DATABASE_NAME="ma_warehouse"
# رمز سوپریز postgres (داخل کانتینر) + رمز رول‌های کم‌دسترسی (ma_app فقط-DML، ma_migrator فقط-DDL)
# هر ۵ مقدار باید یکتا و قوی باشند و با بخش رمزِ URLهای زیر هم‌خوان باشند (راهنما: docs/db-ops.md)
POSTGRES_PASSWORD=CHANGE_ME_32_HEX
MA_APP_DB_PASSWORD=CHANGE_ME_32_HEX
MA_MIGRATOR_DB_PASSWORD=CHANGE_ME_32_HEX
# رانتایم با رول ma_app (فقط DML)؛ sslaccept=accept_invalid_certs برای سرور محلی self-signed
DATABASE_URL="postgresql://ma_app:CHANGE_ME@localhost:5433/ma_warehouse?schema=public&sslmode=require&sslaccept=accept_invalid_certs"
# استخر اتصال PgBouncer (اختیاری) — فقط رانتایم، مهاجرت همیشه مستقیم می‌رود
DATABASE_POOL_URL="postgresql://ma_app:CHANGE_ME@localhost:6432/ma_warehouse?schema=public&sslmode=require&sslaccept=accept_invalid_certs"
# سقف کانکشن پول pg (پیش‌فرض ۲۰ — هم‌خوان با default_pool_size=۳۰ در docker/pgbouncer.ini)
#PG_POOL_MAX=20
# رول مهاجرت (دسترسی DDL) — فقط prisma migrate
MIGRATOR_URL="postgresql://ma_migrator:CHANGE_ME@localhost:5433/ma_warehouse?schema=public&sslmode=require"
SHADOW_DATABASE_URL="postgresql://ma_migrator:CHANGE_ME@localhost:5433/ma_warehouse_shadow?schema=public"

# ── سکرت‌ها (با crypto.randomBytes(32).toString('hex') بسازید) ──
# نکته: چرخش JWT_SECRET همه توکن‌ها و چرخش QR_SECRET همه QRهای چاپ‌شده را باطل می‌کند
JWT_SECRET=CHANGE_ME_32_BYTES_HEX
QR_SECRET=CHANGE_ME_32_BYTES_HEX

# ── خدمات بیرونی ──
# توکن API نرخ دلار (اختیاری؛ بدون آن از tgju عمومی می‌خواند)
ALANCHAND_TOKEN=

# ── دستیار هوش مصنوعی (اختیاری — بدون آن دستیار خطای روشن می‌دهد) ──
# نکته: این مقادیر «پیش‌فرض» هستند. از منوی تنظیمات مدیریت (تنظیمات > دستیار هوش مصنوعی)
# می‌توان مدل را در دیتابیس ذخیره کرد — بدون تغییر کد/env عوض می‌شود و به ردیف دیتابیس اولویت داده می‌شود.
# کلید رایگان از https://z.ai (بخش API Keys)
ZAI_API_KEY=
# مدل پیش‌فرض GLM-4.7-Flash (کاملاً رایگان — GLM-4.5-Flash هم رایگان است)
ZAI_MODEL=glm-4.7-flash
# آدرس پایهٔ سازگار با OpenAI — برای سرویس‌دهنده‌های دیگر اینجا را عوض کنید
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# سقف توکن پاسخ نهایی دستیار (شامل reasoning — کم بودنش پاسخ خالی می‌دهد)
ASSISTANT_MAX_TOKENS=8000

# ── Redis (سوکت/نوبت‌دهی) ──
# ⚠️ الزامی: با docker-compose (requirepass) هم‌خوان باشد؛ بدون رمز، اپ به حالت memory-limiter می‌افتد
REDIS_PASSWORD=CHANGE_ME_32_HEX
REDIS_URL="redis://:CHANGE_ME_32_HEX@localhost:6379"

# ── سرور HTTP ──
PORT=3000
# پشت nginx حتماً true شود (در غیر این صورت IP و rate-limit اشتباه می‌شود) — docs/nginx-production.conf.example
TRUST_PROXY=false
LOG_LEVEL=info

# ── CORS ──
# مبدأهای مجاز با کاما جدا؛ خالی یعنی fail-closed در production (در dev با * کار کنید)
ALLOWED_ORIGINS=""

# ── توکن‌ها ──
# منبع حقیقت TTL اکسس همین‌جاست (پیش‌فرض کد 15m اگر ست نشود)؛ رفرش در REFRESH_TOKEN_TTL
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=90d
# سقف‌های rate-limit (فقط staging/تست؛ پیش‌فرض‌ها رفتار production هستند)
#LOGIN_RATE_MAX=10
#REFRESH_RATE_MAX=30

# ── پشتیبان‌گیری ──
BACKUP_DIR="./backups"
# کپی خودکار آفسایت (هارد اکسترنال یا S3-mount) — خالی یعنی فقط لوکال
BACKUP_REMOTE_DIR=
